// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "alt-1": "project_panel::Toggle"
    }
  },
  {
    "bindings": {
      "alt-2": "git_panel::Toggle",
    },
  },
  {
    "bindings": {
      "alt-3": "multi_workspace::ToggleWorkspaceSidebar"
    }
  },
  {
    "bindings": {
      "ctrl-ä": "agent::Toggle"
    }
  },
  {
    "bindings": {
      "alt-ä": "agent::ToggleFocus"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-i": "assistant::InlineAssist"
    }
  },
  {
    "bindings": {
      "alt-ö": "terminal_panel::ToggleFocus",
    },
  },
  {
    "bindings": {
      "alt-v": "workspace::ToggleVimMode"
    }
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-x ctrl-a": "assistant::InlineAssist"
    }
  }
]
