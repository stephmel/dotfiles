####-- Builtins --####
alias ..='cd ..'
alias ll='ls -alF'
alias c='clear'
alias rm='rm -i'

####-- git --####
alias gl='git log --oneline'
alias gs='git status -sb'
alias ga="git add"
alias gc="git commit"
alias gp='git push'

####-- Tooling --####
alias kc="kubectl"
alias nv="nvim"
