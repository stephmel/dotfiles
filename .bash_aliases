####-- Builtins --####
alias ..='cd ..'
alias ll='ls -alF'
alias rm='rm -i'
alias dus='du -sh *'
alias c='clear'
alias path='tr "." "\n" <<< "$PATH"'

####-- git --####
alias gl='git log --oneline'
alias gs='git status -sb'
alias gam='git add -u'
alias gaa='git add -A'
alias gc='git commit'
alias gp='git push'

####-- Tooling --####
alias kc='kubectl'
alias tf='terraform'
alias nv='nvim'
# alias zed="WAYLAND_DISPLAY='' zed"
